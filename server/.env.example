# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (SQLite by default for zero-config local run; supports PostgreSQL)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/rova?schema=public"

# Authentication
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"
